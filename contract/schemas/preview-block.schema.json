{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "preview-block.schema.json",
  "title": "Preview block",
  "description": "One proposed change on the calendar. Nothing is written until the person confirms. A rest day spans its day and has minutes 0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "activity",
    "title",
    "start",
    "end",
    "minutes",
    "status",
    "reason"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "activity": {
      "$ref": "activity.schema.json"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "start": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(\\.\\d{1,3})?[+-]([01]\\d|2[0-3]):[0-5]\\d$"
    },
    "end": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(\\.\\d{1,3})?[+-]([01]\\d|2[0-3]):[0-5]\\d$"
    },
    "minutes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1440
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "moved",
        "resized",
        "cancelled"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  }
}
