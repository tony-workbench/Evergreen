{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memory-row.schema.json",
  "title": "Memory row",
  "description": "One memory in the daily table. `key` is opaque; what a consumer needs is in `data`, by `kind`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "memoryId",
    "key",
    "slot",
    "group",
    "kind",
    "statement",
    "data",
    "state",
    "confidence",
    "since",
    "updated"
  ],
  "properties": {
    "memoryId": {
      "type": "string",
      "minLength": 1
    },
    "key": {
      "type": "string",
      "minLength": 1
    },
    "slot": {
      "type": "string",
      "minLength": 1
    },
    "group": {
      "type": "string",
      "enum": [
        "routine",
        "body",
        "load",
        "response",
        "gear",
        "goal"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "usual_slot",
        "weekly_volume",
        "load",
        "sleep",
        "resting_hr",
        "mix",
        "response",
        "gear",
        "goal"
      ]
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object"
    },
    "state": {
      "type": "string",
      "enum": [
        "candidate",
        "saved",
        "confirmed",
        "rejected",
        "superseded",
        "inactive"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "since": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
    }
  },
  "oneOf": [
    {
      "properties": {
        "kind": {
          "const": "usual_slot"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "activity",
            "weekday",
            "hour",
            "minutes",
            "weeksSeen",
            "weeksTotal"
          ],
          "properties": {
            "activity": {
              "$ref": "activity.schema.json"
            },
            "weekday": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            },
            "hour": {
              "type": "integer",
              "minimum": 0,
              "maximum": 23
            },
            "minutes": {
              "type": "integer",
              "minimum": 5,
              "maximum": 240
            },
            "weeksSeen": {
              "type": "integer",
              "minimum": 0
            },
            "weeksTotal": {
              "type": "integer",
              "minimum": 1
            },
            "label": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "weekly_volume"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "workoutsPerWeek",
            "minutesPerWeek"
          ],
          "properties": {
            "workoutsPerWeek": {
              "type": "number",
              "minimum": 0
            },
            "minutesPerWeek": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "load"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minutes7d",
            "ratioToUsual"
          ],
          "properties": {
            "minutes7d": {
              "type": "number",
              "minimum": 0
            },
            "ratioToUsual": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          }
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "sleep"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hours7d",
            "hours28d"
          ],
          "properties": {
            "hours7d": {
              "type": "number",
              "minimum": 0,
              "maximum": 24
            },
            "hours28d": {
              "type": "number",
              "minimum": 0,
              "maximum": 24
            }
          }
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "resting_hr"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bpm7d",
            "bpm28d"
          ],
          "properties": {
            "bpm7d": {
              "type": "number",
              "minimum": 20,
              "maximum": 250
            },
            "bpm28d": {
              "type": "number",
              "minimum": 20,
              "maximum": 250
            }
          }
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "mix"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "byActivity"
          ],
          "properties": {
            "byActivity": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "run": {
                  "type": "integer",
                  "minimum": 0
                },
                "long_run": {
                  "type": "integer",
                  "minimum": 0
                },
                "walk": {
                  "type": "integer",
                  "minimum": 0
                },
                "strength": {
                  "type": "integer",
                  "minimum": 0
                },
                "yoga": {
                  "type": "integer",
                  "minimum": 0
                },
                "ride": {
                  "type": "integer",
                  "minimum": 0
                },
                "swim": {
                  "type": "integer",
                  "minimum": 0
                },
                "elliptical": {
                  "type": "integer",
                  "minimum": 0
                },
                "stretch": {
                  "type": "integer",
                  "minimum": 0
                },
                "rest": {
                  "type": "integer",
                  "minimum": 0
                },
                "other": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "response"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "about",
            "pattern"
          ],
          "properties": {
            "about": {
              "type": "string",
              "minLength": 1
            },
            "pattern": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "gear"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "item",
            "km",
            "boughtOn"
          ],
          "properties": {
            "item": {
              "type": "string",
              "minLength": 1
            },
            "km": {
              "type": "number",
              "minimum": 0
            },
            "boughtOn": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
            }
          }
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "goal"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "what",
            "date"
          ],
          "properties": {
            "what": {
              "type": "string",
              "minLength": 1
            },
            "date": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
            }
          }
        }
      }
    }
  ]
}
